msgstr ""

#: src/polls/templates/polls/email/html/poll_reminder.html
#, python-format
msgid "Hi %(first_name)s, <br />we need you to fill out some polls."
msgstr "Hi %(first_name)s, <br />wir brauchen dich um einige Umfragen auszufüllen."

#: src/polls/templates/polls/email/html/poll_reminder.html
#, python-format
msgid ""
"This is just a friendly reminder that the following %(poll_count)s polls "
"will be closing in %(timediff)s days.<br />\n"
"If you haven't had the chance to answer yet, please do so as soon as "
"possible to make sure your voice is heard.<br />\n"
"To cast your vote, simply log in to your account and visit the polling page. "
"If you have any trouble accessing the page or experience any other issues, "
"please let us know as soon as possible so we can assist you.<br />\n"
"<strong>Keep in mind that polls which can be answered multiple times are "
"still listed.</strong>\n"
msgstr ""
"Dies ist eine freundliche Erinnerung, dass die folgenden %(poll_count)s "
"Umfragen in in %(timediff)s Tagen schließen.<br />\n"
"Versuche diese so schnell wie möglich zu beantworten um sicher zu gehen, "
"dass deine Stimme gehört wird.\n"
"Um abzustimmen, logge dich einfach in deinen account ein und besuche die "
"Umfragen Seite. Wenn du Probleme hast die Seite zu besuchen oder ähnliches, "
"lasse es uns so früh wie möglich wissen, damit wir helfen können.<br />\n"
"\n"
"<strong>Beachte, dass Umfragen, die mehrfach beantwortet werden können, "
"trotzen aufgelistet werden</strong>\n"

#: src/polls/templates/polls/email/text/poll_reminder.txt
#, python-format
msgid ""
"Hi %(first_name)s,\n"
"This is just a friendly reminder that the following %(poll_count)s polls "
"will be closing in %(timediff)s days.\n"
"If you haven't had the chance to answer yet, please do so as soon as "
"possible to make sure your voice is heard.\n"
"To cast your vote, simply log in to your account and visit the polling page. "
"If you have any trouble accessing the page or experience any other issues, "
"please let us know as soon as possible so we can assist you.\n"
"\n"
"Keep in mind that polls which can be answered multiple times are still "
"listed.\n"
msgstr ""
"Hi %(first_name)s,\n"
"Dies ist eine freundliche Erinnerung, dass die folgenden %(poll_count)s "
"Umfragen in in %(timediff)s Tagen schließen.\n"
"Versuche diese so schnell wie möglich zu beantworten um sicher zu gehen, "
"dass deine Stimme gehört wird.\n"
"Um abzustimmen, logge dich einfach in deinen account ein und besuche die "
"Umfragen Seite. Wenn du Probleme hast die Seite zu besuchen oder ähnliches, "
"lasse es uns so früh wie möglich wissen, damit wir helfen können.\n"
"\n"
"Beachte, dass Umfragen, die mehrfach beantwortet werden können, trotzen "
"aufgelistet werden\n"

