#: src/theme/templates/404.html
msgid "Resource not found"
msgstr "Ressource nicht gefunden"

#: src/theme/templates/404.html
#, python-format
msgid ""
"\n"
"    <span class=\"has-text-warning title\">Resource not found</span> <br>\n"
"    The resource you tried to access does not exist. <br>\n"
"    You can return to the main page <a href=\"/\">here</a><br><br><br>\n"
"    If you think this is a mistake contact the admin at <a href=\"mailto:"
"%(ADMIN_URL)s\">%(ADMIN_URL)s</a>\n"
"    "
msgstr ""
"\n"
"    <span class=\"has-text-warning title\">Ressource nicht gefunden</span> "
"<br>\n"
"    Die aufgerufene Ressource konnte nicht gefunden werden. <br>\n"
"    Kehre <a href=\"/\">hier</a> zur Hauptseite zurück><br><br><br>\n"
"    Wenn du denkst, dass dies ein Fehler ist, kontaktiere einen admin unter "
"<a href=\"mailto:%(ADMIN_URL)s\">%(ADMIN_URL)s</a>\n"
"    "

#: src/theme/templates/500.html
msgid "Internal Server Error"
msgstr "Interner Server Fehler"

#: src/theme/templates/500.html
#, python-format
msgid ""
"\n"
"    <p class=\"title has-text-danger has-text-centered\">A Fatal Server "
"Error Occurred</p>\n"
"    <div class=\"has-text-centered\">\n"
"        Please contact the administrator immediately! <br>\n"
"        <span class=\"icon-text\">\n"
"            <span class=\"icon\">\n"
"                <i class=\"fa-solid fa-envelope\"></i>\n"
"            </span>\n"
"            <span> <a href=\"mailto:%(ADMIN_EMAIL)s\">%(ADMIN_EMAIL)s</a></"
"span>\n"
"        </span>\n"
"    </div>\n"
"    "
msgstr ""
"\n"
"    <p class=\"title has-text-danger has-text-centered\">Es ist ein Server "
"Fehler aufgetreten</p>\n"
"    <div class=\"has-text-centered\">\n"
"        Bitte kontaktiere sofort einen Administrator! <br>\n"
"        <span class=\"icon-text\">\n"
"            <span class=\"icon\">\n"
"                <i class=\"fa-solid fa-envelope\"></i>\n"
"            </span>\n"
"            <span> <a href=\"mailto:%(ADMIN_EMAIL)s\">%(ADMIN_EMAIL)s</a></"
"span>\n"
"        </span>\n"
"    </div>\n"
"    "

